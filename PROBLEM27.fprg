        <attribute name="edited" value="c2FtaWE7REVTS1RPUC0zUFVCNVYxOzE0NDgtMDQtMTU7MDY6MTY6Mjkg2YU7MTs0NDI3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="counter, i" type="Integer" array="False" size=""/>
            <input variable="i"/>
            <assign variable="counter" expression="i + 1"/>
            <while expression="counter &gt; 0">
                <output expression="counter" newline="True"/>
                <assign variable="counter" expression="counter - 1"/>
            </while>
        </body>
    </function>
</flowgorithm>
