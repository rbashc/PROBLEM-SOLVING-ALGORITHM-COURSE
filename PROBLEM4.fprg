        <attribute name="edited" value="2KfYqNmIINit2LPZhjtMQVBUT1AtOENFTUJUTTM7MjAyNi0wNy0zMTswMzoyOTozOCDZhTsxOzEzNDY3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="age" type="Integer" array="False" size=""/>
            <declare name="driveLicense, result" type="Boolean" array="False" size=""/>
            <input variable="age"/>
            <input variable="driveLicense"/>
            <assign variable="result" expression="(age &gt; 21 &amp;&amp; driveLicense == true)"/>
            <if expression="result = true">
                <then>
                    <output expression="&quot;Hired&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Rejected&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
