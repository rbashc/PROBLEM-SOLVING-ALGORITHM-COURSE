        <attribute name="edited" value="c2FtaWE7REVTS1RPUC0zUFVCNVYxOzE0NDgtMDQtMTU7MDg6MTM6NDAg2YU7MTs0NDE5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, counter, sum" type="Integer" array="False" size=""/>
            <input variable="i"/>
            <assign variable="sum" expression="0"/>
            <assign variable="counter" expression="0"/>
            <for variable="counter" start="0" end="i" direction="inc" step="1">
                <if expression="counter % 2 == 0">
                    <then>
                        <assign variable="sum" expression="sum + counter"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
