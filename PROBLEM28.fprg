<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PROBLEM28"/>
        <attribute name="authors" value="samia"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="1448-04-15 07:46:57 &#1605;"/>
        <attribute name="created" value="c2FtaWE7REVTS1RPUC0zUFVCNVYxOzE0NDgtMDQtMTU7MDY6MzU6Mjcg2YU7NDMxOA=="/>
        <attribute name="edited" value="c2FtaWE7REVTS1RPUC0zUFVCNVYxOzE0NDgtMDQtMTU7MDc6NDY6NTcg2YU7MTs0NDMy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, counter, sum" type="Integer" array="False" size=""/>
            <input variable="i"/>
            <assign variable="sum" expression="0"/>
            <assign variable="counter" expression="0"/>
            <for variable="counter" start="0" end="i" direction="inc" step="1">
                <if expression="counter % 2 == 0">
                    <then/>
                    <else>
                        <assign variable="sum" expression="sum + counter"/>
                    </else>
                </if>
            </for>
            <output expression="sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
