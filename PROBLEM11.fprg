        <attribute name="edited" value="2KfYqNmIINit2LPZhjtMQVBUT1AtOENFTUJUTTM7MjAyNi0wNy0zMTswODoyNzo0MSDZhTsxOzEzNDY0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="mark1, mark2, mark3, sum" type="Integer" array="False" size=""/>
            <input variable="mark1"/>
            <input variable="mark2"/>
            <input variable="mark3"/>
            <assign variable="sum" expression="(mark1 + mark2 + mark3) / 3"/>
            <output expression="sum" newline="True"/>
            <if expression="sum &gt;= 50">
                <then>
                    <output expression="&quot;PASS&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;FAIL&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
