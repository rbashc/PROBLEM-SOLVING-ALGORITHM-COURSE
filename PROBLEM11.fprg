    <attributes>
        <attribute name="name" value="PROBLEM11"/>
        <attribute name="authors" value="&#1575;&#1576;&#1608; &#1581;&#1587;&#1606;"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-31 08:27:41 &#1605;"/>
