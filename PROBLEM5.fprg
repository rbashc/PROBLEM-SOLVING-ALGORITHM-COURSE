    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="age" type="Integer" array="False" size=""/>
            <declare name="driveLicense, HasRecommendation, result" type="Boolean" array="False" size=""/>
            <input variable="age"/>
            <input variable="driveLicense"/>
            <input variable="HasRecommendation"/>
            <if expression="HasRecommendation == true">
                <then>
                    <output expression="&quot;Hired&quot;" newline="True"/>
                </then>
                <else>
                    <assign variable="result" expression="(age &gt; 21 &amp;&amp; driveLicense == true)"/>
                    <if expression="result == true">
                        <then>
                            <output expression="&quot;Hired&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Rejected&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
