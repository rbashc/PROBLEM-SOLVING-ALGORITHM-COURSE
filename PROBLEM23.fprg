<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PROBLEM23"/>
        <attribute name="authors" value="&#1575;&#1576;&#1608; &#1581;&#1587;&#1606;"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-02 02:26:24 &#1605;"/>
        <attribute name="created" value="2KfYqNmIINit2LPZhjtMQVBUT1AtOENFTUJUTTM7MjAyNi0wOC0wMjswMTo1NToyMSDZhTsxMzM0Nw=="/>
        <attribute name="edited" value="2KfYqNmIINit2LPZhjtMQVBUT1AtOENFTUJUTTM7MjAyNi0wOC0wMjswMjoyNjoyNCDZhTsxOzEzNDU3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="A, B, C, AREA, P, X" type="Real" array="False" size=""/>
            <input variable="A"/>
            <input variable="B"/>
            <input variable="C"/>
            <assign variable="P" expression="(A + B + C) / 2"/>
            <assign variable="X" expression="(A * B * C) / (4 * sqrt(P * (P - A) * (P - B) * (P - C)))"/>
            <assign variable="X" expression="X * X"/>
            <assign variable="AREA" expression="PI * X"/>
            <output expression="AREA" newline="True"/>
        </body>
    </function>
</flowgorithm>
