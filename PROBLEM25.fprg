    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Age" type="Integer" array="False" size=""/>
            <input variable="Age"/>
            <while expression="Age &lt; 18 || Age &gt; 45">
                <output expression="&quot;Invalid Age, try again&quot;" newline="True"/>
                <input variable="Age"/>
            </while>
            <output expression="&quot;Valid Age&quot;" newline="True"/>
        </body>
    </function>
