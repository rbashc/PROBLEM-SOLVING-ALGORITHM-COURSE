    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="A, D, AREA" type="Real" array="False" size=""/>
            <input variable="A"/>
            <input variable="D"/>
            <assign variable="AREA" expression="A * sqrt(D*D - A*A)"/>
            <output expression="AREA" newline="True"/>
        </body>
    </function>
