<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="PROBLEM30"/>
        <attribute name="authors" value="samia"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="1448-04-15 08:38:39 &#1605;"/>
        <attribute name="created" value="c2FtaWE7REVTS1RPUC0zUFVCNVYxOzE0NDgtMDQtMTU7MDg6MTY6MjUg2YU7NDMxNw=="/>
        <attribute name="edited" value="c2FtaWE7REVTS1RPUC0zUFVCNVYxOzE0NDgtMDQtMTU7MDg6Mzg6Mzkg2YU7MTs0NDM0"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="number, counter, factorial" type="Integer" array="False" size=""/>
            <input variable="number"/>
            <while expression="number &lt;= 0">
                <output expression="&quot;Factorial must be positive number&quot;" newline="True"/>
                <input variable="number"/>
            </while>
            <assign variable="counter" expression="number + 1"/>
            <assign variable="factorial" expression="1"/>
            <while expression="counter != 1">
                <assign variable="counter" expression="counter - 1"/>
                <assign variable="factorial" expression="factorial * counter"/>
            </while>
            <output expression="factorial" newline="True"/>
        </body>
    </function>
</flowgorithm>
