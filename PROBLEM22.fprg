    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="A, B, AREA" type="Real" array="False" size=""/>
            <input variable="A"/>
            <input variable="B"/>
            <assign variable="AREA" expression="(PI * ((B * B) / 4)) * ((2 * A - B) / (2 * A + B))"/>
            <output expression="AREA" newline="True"/>
        </body>
    </function>
</flowgorithm>
