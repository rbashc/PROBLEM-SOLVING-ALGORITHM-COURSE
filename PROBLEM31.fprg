    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="number, n1, n2, n3" type="Integer" array="False" size=""/>
            <input variable="number"/>
            <assign variable="n1" expression="number * number"/>
            <assign variable="n2" expression="number * number * number"/>
            <assign variable="n3" expression="number * number * number * number"/>
            <output expression="n1" newline="True"/>
            <output expression="n2" newline="True"/>
            <output expression="n3" newline="True"/>
        </body>
    </function>
