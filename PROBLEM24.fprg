    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="AGE" type="Integer" array="False" size=""/>
            <declare name="RESULT" type="Boolean" array="False" size=""/>
            <input variable="AGE"/>
            <assign variable="RESULT" expression="(AGE &gt;= 18 &amp;&amp; AGE &lt;= 45)"/>
            <if expression="RESULT = true">
                <then>
                    <output expression="&quot;VALID AGE&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;INVALID AGE&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
